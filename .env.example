# ==============================================================================
# ClinicDocs AI Configuration
# ==============================================================================

# LLM Provider selection: "groq" (default) or "gemini"
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# Groq Configuration (Fast, generous free tier at https://console.groq.com)
# Recommended models:
#   - llama-3.1-8b-instant (Default, fast, 128k context)
#   - llama-3.3-70b-versatile (Higher reasoning capacity)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# Google Gemini Configuration (Alternative provider at https://aistudio.google.com)
# Recommended models:
#   - gemini-2.0-flash (Current fast production model)
#   - gemini-2.5-flash (If available in your region/account)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# Uses FastEmbed (ONNX runtime, ~40MB download, runs on CPU without PyTorch)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# Retrieval & Guardrail Settings
# ------------------------------------------------------------------------------
# Initial similarity threshold (calibrated empirically in Step 3)
SIMILARITY_THRESHOLD=0.35
RETRIEVER_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# In-memory session eviction cap (maximum concurrent Chroma collections kept in RAM)
MAX_ACTIVE_COLLECTIONS=10

# Logging Level (INFO, DEBUG, WARNING)
LOG_LEVEL=INFO
